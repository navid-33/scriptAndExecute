# .gitignore

# ==========================
# Dependencies
# ==========================
node_modules/

# ==========================
# Environment Variables
# ==========================
.env
.env.*
!.env.example

# ==========================
# Playwright
# ==========================
playwright-report/
test-results/
blob-report/

# Screenshots, videos, traces
*.png
*.webm
*.zip

# ==========================
# Build Output
# ==========================
dist/
build/

# ==========================
# Coverage
# ==========================
coverage/

# ==========================
# Logs
# ==========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# JetBrains (WebStorm / IntelliJ)
# ==========================
.idea/

# ==========================
# VS Code
# ==========================
.vscode/

# ==========================
# Operating System Files
# ==========================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================
# Temporary Files
# ==========================
*.tmp
*.temp